{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"],
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["extensions/*.ts"],
  "exclude": ["node_modules"]
}
